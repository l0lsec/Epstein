# Local config for deploy.sh — copy to .deploy.env and fill in.
# .deploy.env is gitignored and should never be committed.

# SSH host (IP or hostname) of the production server
SSH_HOST=your.server.ip.or.host

# SSH user with sudo rights on the production server
SSH_USER=your_ssh_user

# Path to the project on the production server
REMOTE_DIR=/opt/epstein

# Name of the systemd service that runs the app
SERVICE_NAME=epstein
